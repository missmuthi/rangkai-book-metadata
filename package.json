{
  "name": "rangkai-book-metadata",
  "private": true,
  "version": "2.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:wrangler": "wrangler pages dev .svelte-kit/cloudflare --compatibility-date=2024-01-01 --d1=DB --kv=BOOK_CACHE --port=8788",
    "dev:full": "npm run build && npm run dev:wrangler",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "./validate-all.sh",
    "deploy": "npm run build && wrangler pages deploy .svelte-kit/cloudflare",
    "typegen": "wrangler types && svelte-kit sync",
    "db:migrate:local": "wrangler d1 execute DB --local --file=./schema.sql",
    "db:migrate:prod": "wrangler d1 execute DB --remote --file=./schema.sql",
    "diagnostic": "node diagnostic.js",
    "diagnostic:fast": "node diagnostic.js --fast"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.3",
    "@eslint/js": "^9.39.1",
    "@sveltejs/adapter-cloudflare": "^7.2.4",
    "@sveltejs/kit": "^2.49.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/typography": "^0.5.14",
    "@testing-library/svelte": "^5.2.9",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.1",
    "eslint-plugin-svelte": "^3.13.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^27.2.0",
    "prettier": "^3.7.3",
    "prettier-plugin-svelte": "^3.3.2",
    "svelte": "^5.45.2",
    "svelte-check": "^4.3.4",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.2.4",
    "vitest": "^4.0.14",
    "wrangler": "^4.51.0"
  },
  "dependencies": {
    "@ai-sdk/google": "^2.0.43",
    "@cloudflare/workers-types": "^4.20251121.0",
    "ai": "^5.0.103",
    "arctic": "^3.7.0",
    "better-auth": "^1.4.3",
    "html5-qrcode": "^2.3.8",
    "kysely": "^0.28.8",
    "kysely-d1": "^0.4.0",
    "zod": "^4.1.13"
  },
  "overrides": {
    "cookie": "^0.7.2"
  }
}
