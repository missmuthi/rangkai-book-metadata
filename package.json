{
	"name": "rangkai-book-metadata",
	"private": true,
	"version": "2.0.2",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:wrangler": "wrangler pages dev .svelte-kit/cloudflare --compatibility-date=2024-01-01 --d1=DB --kv=BOOK_CACHE --port=8788",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"test": "vitest",
		"test:watch": "vitest --watch",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"deploy": "npm run build && wrangler pages deploy .svelte-kit/cloudflare",
		"diagnostic": "node diagnostic.js",
		"diagnostic:fast": "node diagnostic.js --fast"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-cloudflare": "^7.2.4",
		"@sveltejs/kit": "^2.47.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/typography": "^0.5.14",
		"@testing-library/svelte": "^4.0.0",
		"@types/node": "^24.10.1",
		"autoprefixer": "^10.4.20",
		"husky": "^8.0.0",
		"jsdom": "^27.2.0",
		"svelte": "^5.41.0",
		"svelte-check": "^4.3.3",
		"tailwindcss": "^3.4.9",
		"typescript": "^5.9.3",
		"vite": "^7.1.10",
		"vitest": "^1.0.0"
	},
	"dependencies": {
		"@cloudflare/workers-types": "^4.20251121.0",
		"arctic": "^3.7.0",
		"kysely": "^0.28.8",
		"kysely-d1": "^0.4.0"
	}
}
