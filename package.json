{
  "name": "rangkai-book-metadata",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:wrangler": "wrangler pages dev .svelte-kit/cloudflare --compatibility-date=2024-01-01 --d1=DB --kv=BOOK_CACHE --port=8788",
    "dev:full": "npm run build && npm run dev:wrangler",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "husky install && svelte-kit sync || echo ''",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "./validate-all.sh",
    "deploy": "npm run build && wrangler pages deploy .svelte-kit/cloudflare",
    "typegen": "wrangler types && svelte-kit sync",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --reporter=list --workers=1",
    "test:e2e:smoke": "playwright test --grep 'Search by ISBN displays merged metadata card' --workers=1 --reporter=list",
    "db:migrate:local": "wrangler d1 execute DB --local --file=./schema.sql",
    "db:migrate:prod": "wrangler d1 execute DB --remote --file=./schema.sql",
    "db:migrate:drizzle": "npx drizzle-kit generate --schema ./src/lib/server/db/schema.ts --out ./migrations --driver d1-http --dialect sqlite",
    "db:migrate:drizzle:check": "npx drizzle-kit generate --schema ./src/lib/server/db/schema.ts --out ./drizzle-temp --driver d1-http --dialect sqlite && git --no-pager diff --no-index --name-only ./migrations ./drizzle-temp || true",
    "diagnostic": "node diagnostic.js",
    "diagnostic:fast": "node diagnostic.js --fast",
    "tsx:verify": "tsx ./scripts/tsx-check.ts"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.4",
    "@cloudflare/workers-types": "4.20251202.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.44.0",
    "@sveltejs/adapter-cloudflare": "^7.2.4",
    "@sveltejs/kit": "^2.49.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/typography": "^0.5.14",
    "@testing-library/svelte": "^5.2.9",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^1.0.0-beta.1",
    "drizzle-orm": "^0.44.7",
    "eslint": "^9.39.1",
    "eslint-plugin-svelte": "^3.13.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^27.2.0",
    "prettier": "^3.7.3",
    "prettier-plugin-svelte": "^3.3.2",
    "svelte": "5.53.0",
    "svelte-check": "^4.3.4",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "7.2.6",
    "vitest": "^4.0.14",
    "wrangler": "^4.51.0"
  },
  "dependencies": {
    "@ai-sdk/openai": "2.0.76",
    "ai": "5.0.106",
    "arctic": "^3.7.0",
    "better-auth": "^1.4.4",
    "html5-qrcode": "^2.3.8",
    "kysely": "^0.28.8",
    "kysely-d1": "^0.4.0",
    "zod": "^4.1.13"
  },
  "overrides": {
    "cookie": "^0.7.2"
  }
}
